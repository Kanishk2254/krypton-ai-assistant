# Krypton Environment Configuration
# Copy this file to .env and set your values

# Security PIN (4 digits)
KRYPTON_PIN=1234

# Optional: API Keys (if you add weather/other services)
WEATHER_API_KEY="c09acf824c95a28f5c88ae06991d1699"
# OPENAI_API_KEY=your_api_key_here

# Debug settings
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Security settings
SESSION_TIMEOUT_MINUTES=5
MAX_FAILED_ATTEMPTS=3

# Voice settings
DEFAULT_VOICE_SPEED=200
DEFAULT_VOICE_VOLUME=0.9
